{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "/*", "close": "*/", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:module|macromodule|primitive|begin|case|casex|casez|fork|generate|function|task)\\b(?![^;]*;\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:end|endmodule|endprimitive|endcase|endgenerate|join|join_any|join_none|endfunction|endtask)\\b"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_$]*"
}
