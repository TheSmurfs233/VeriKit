{
  "name": "verikit",
  "displayName": "VeriKit — Verilog 编辑助手",
  "description": "Verilog 代码编写辅助：高亮、语法检查、模块索引与一键例化",
  "version": "0.2.1",
  "publisher": "qaq7321",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "verikit.showDiagnostics",
        "title": "显示诊断信息",
        "category": "VeriKit"
      },
      {
        "command": "verikit.exportDiagnostics",
        "title": "导出诊断 JSON",
        "category": "VeriKit"
      },
      {
        "command": "verikit.lintFileRaw",
        "title": "检查当前文件（原始输出）",
        "category": "VeriKit"
      },
      {
        "command": "verikit.probeToolchain",
        "title": "检测工具链",
        "category": "VeriKit"
      },
      {
        "command": "verikit.pickToolchain",
        "title": "选择工具链可执行文件",
        "category": "VeriKit"
      }
    ],
    "configuration": {
      "title": "VeriKit",
      "properties": {
        "verikit.toolchain": {
          "type": "string",
          "enum": [
            "xvlog",
            "none"
          ],
          "enumDescriptions": [
            "使用 Vivado 的 xvlog 做语法检查",
            "禁用语法检查（不探测、不调用任何外部进程）"
          ],
          "default": "xvlog",
          "scope": "resource",
          "order": 1,
          "markdownDescription": "语法检查使用的工具链。目前仅支持 `xvlog`。"
        },
        "verikit.xvlog.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 2,
          "markdownDescription": "**xvlog 可执行文件的绝对路径**。\n\n留空时按 `配置 → PATH → %XILINX_VIVADO% → 扫描目录` 的顺序自动探测。\n\n支持 `${env:VAR}` 与 `~` 展开。Windows 下需要 `.exe` / `.cmd` / `.bat`。\n\n不想手打路径？执行命令 **VeriKit: 选择工具链可执行文件**。"
        },
        "verikit.probe.scanDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "order": 3,
          "markdownDescription": "自动探测失败时的额外扫描目录（每个目录下直接查找可执行文件）。默认空，不硬编码任何厂商安装路径。"
        },
        "verikit.check.timeout": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "scope": "resource",
          "order": 4,
          "markdownDescription": "单次调用外部工具的超时（毫秒）。实测 `xvlog -version` 约 1 s，真正的语法检查会更久。"
        }
      }
    },
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "arch": "node test/arch.js",
    "doc": "python test/doc_check.py",
    "verify": "bash verify.sh",
    "package": "vsce package --allow-missing-repository -o dist/verikit.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^24.19.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
