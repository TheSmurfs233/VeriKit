{
  "name": "fpga-verilog-helper",
  "displayName": "FPGA Verilog Helper",
  "description": "Verilog 代码编写辅助：高亮、语法检查、模块索引与一键例化",
  "version": "0.0.2",
  "publisher": "qaq7321",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fpga.showDiagnostics",
        "title": "显示诊断信息",
        "category": "FPGA"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "arch": "node test/arch.js",
    "doc": "python test/doc_check.py",
    "verify": "bash verify.sh",
    "package": "vsce package --allow-missing-repository -o dist/fpga-verilog-helper.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
