{
  "name": "verikit",
  "displayName": "VeriKit — Verilog 编辑助手",
  "description": "Verilog 代码编写辅助：高亮、语法检查、模块索引与一键例化",
  "version": "0.11.1",
  "publisher": "qaq7321",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "verikit.showDiagnostics",
        "title": "显示诊断信息",
        "category": "VeriKit"
      },
      {
        "command": "verikit.exportDiagnostics",
        "title": "导出诊断 JSON",
        "category": "VeriKit"
      },
      {
        "command": "verikit.inspectLanguage",
        "title": "诊断语言与着色",
        "category": "VeriKit"
      },
      {
        "command": "verikit.lintFileRaw",
        "title": "检查当前文件（原始输出）",
        "category": "VeriKit"
      },
      {
        "command": "verikit.probeToolchain",
        "title": "检测工具链",
        "category": "VeriKit"
      },
      {
        "command": "verikit.pickToolchain",
        "title": "选择工具链可执行文件",
        "category": "VeriKit"
      },
      {
        "command": "verikit.selfCheckParser",
        "title": "解析器自检（版本兼容）",
        "category": "VeriKit"
      },
      {
        "command": "verikit.pickTopModule",
        "title": "指定 Top 模块",
        "category": "VeriKit",
        "icon": "$(target)"
      },
      {
        "command": "verikit.refreshModuleTree",
        "title": "刷新模块树",
        "category": "VeriKit",
        "icon": "$(refresh)"
      },
      {
        "command": "verikit.openModuleDefinition",
        "title": "转到模块定义",
        "category": "VeriKit"
      },
      {
        "command": "verikit.instantiateModule",
        "title": "例化模块（复制到剪贴板）",
        "category": "VeriKit"
      }
    ],
    "configuration": {
      "title": "VeriKit",
      "properties": {
        "verikit.tree.topModule": {
          "type": "string",
          "default": "",
          "markdownDescription": "模块树显示的顶层模块名（空 = 未指定，会提示选择）"
        },
        "verikit.check.timeout": {
          "type": "number",
          "default": 15000,
          "description": "单文件语法检查超时（毫秒）"
        },
        "verikit.check.onEdit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**编辑时检查**（不保存也出红线）。开启后：停止输入 1 秒即把缓冲区内容写入临时副本交给 xvlog。代价：每次检查约 1 秒 CPU。保存时仍会以磁盘版本做最终确认。"
        },
        "verikit.xvlog.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "xvlog.bat 的完整路径（探测**第 1 级**使用，支持 `${env:变量名}` 与 `~`）。**通常留空**：留空时按 PATH → XILINX_VIVADO 环境变量 → 扫描目录级联探测；全部失败再用「VeriKit: 选择工具链」命令指定（会写入本项并立即重新探测）。"
        },
        "verikit.probe.scanDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "探测**第 4 级**的额外扫描目录列表（每项一个目录，会在其中查找 xvlog.bat）。用于多版本 Vivado 共存或非标准安装位置。留空则只按前三级探测。"
        }
      }
    },
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.control.verilog",
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "scope": "keyword.control.task.verilog",
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "scope": "keyword.control.preprocessor.verilog",
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "scope": "storage.modifier.verilog",
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "scope": "keyword.other.edge.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "keyword.other.module.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "keyword.other.block.l1.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "keyword.other.block.l2.verilog",
            "settings": {
              "foreground": "#B45F04"
            }
          },
          {
            "scope": "keyword.other.block.l3.verilog",
            "settings": {
              "foreground": "#0E8A8A"
            }
          },
          {
            "scope": "keyword.other.block.l4.verilog",
            "settings": {
              "foreground": "#AF00DB"
            }
          },
          {
            "scope": "keyword.other.block.l5.verilog",
            "settings": {
              "foreground": "#A31515"
            }
          },
          {
            "scope": "keyword.other.block.l6.verilog",
            "settings": {
              "foreground": "#6B8E23"
            }
          },
          {
            "scope": "storage.type.port.verilog",
            "settings": {
              "foreground": "#267F99"
            }
          },
          {
            "scope": "storage.type.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "keyword.operator.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "entity.name.type.instance.verilog",
            "settings": {
              "foreground": "#0000FF"
            }
          },
          {
            "scope": "entity.name.instance.verilog",
            "settings": {
              "foreground": "#0E8A8A"
            }
          },
          {
            "scope": "variable.other.port.verilog",
            "settings": {
              "foreground": "#A0522D"
            }
          },
          {
            "scope": "entity.name.type.module.verilog",
            "settings": {
              "foreground": "#267F99"
            }
          },
          {
            "scope": "entity.name.function.verilog",
            "settings": {
              "foreground": "#795E26"
            }
          },
          {
            "scope": "constant.numeric.verilog",
            "settings": {
              "foreground": "#098658"
            }
          },
          {
            "scope": "string.quoted.double.verilog",
            "settings": {
              "foreground": "#A31515"
            }
          },
          {
            "scope": "support.function.system.verilog",
            "settings": {
              "foreground": "#795E26"
            }
          },
          {
            "scope": "variable.other.macro.verilog",
            "settings": {
              "foreground": "#795E26"
            }
          },
          {
            "scope": "comment.line.double-slash.verilog",
            "settings": {
              "foreground": "#008000"
            }
          },
          {
            "scope": "comment.block.verilog",
            "settings": {
              "foreground": "#008000"
            }
          }
        ]
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verikit",
          "title": "VeriKit",
          "icon": "media/verikit.svg"
        }
      ]
    },
    "views": {
      "verikit": [
        {
          "id": "verikit.moduleTree",
          "name": "模块树"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "verikit.pickTopModule",
          "group": "navigation@1",
          "when": "view == verikit.moduleTree"
        },
        {
          "command": "verikit.refreshModuleTree",
          "group": "navigation@2",
          "when": "view == verikit.moduleTree"
        }
      ],
      "view/item/context": [
        {
          "command": "verikit.instantiateModule",
          "when": "view == verikit.moduleTree && viewItem == module",
          "group": "instantiate@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "arch": "node test/arch.js",
    "doc": "python test/doc_check.py",
    "verify": "bash verify.sh",
    "package": "vsce package --allow-missing-repository -o dist/verikit.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^24.19.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSmurfs233/VeriKit.git"
  },
  "bugs": {
    "url": "https://github.com/TheSmurfs233/VeriKit/issues"
  },
  "homepage": "https://github.com/TheSmurfs233/VeriKit#readme"
}
