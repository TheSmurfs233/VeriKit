{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verilog",
  "scopeName": "source.verilog",
  "comment": "手写 Verilog-2001 子集。三条原则：① 注释/字符串最先匹配，否则 // module foo 里的 module 会被着色；② 语义不同的事物给不同 scope，否则主题只能涂一种颜色；③ begin/end 用 6 层定深嵌套链（block-1..block-6）实现逐层变色，第 6 层自递归承接更深的嵌套。",
  "patterns": [
    {
      "include": "#block-1"
    },
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "statement": {
      "comment": "块内外的公共规则。begin/end 不在这里 —— 它们由 block-N 链处理。",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#module"
        },
        {
          "include": "#task-function"
        },
        {
          "include": "#edge"
        },
        {
          "include": "#control"
        },
        {
          "include": "#port-direction"
        },
        {
          "include": "#storage"
        },
        {
          "include": "#modifier"
        },
        {
          "include": "#number"
        },
        {
          "include": "#system-task"
        },
        {
          "include": "#instance-param"
        },
        {
          "include": "#instance-inline"
        },
        {
          "include": "#instance-name"
        },
        {
          "include": "#port-connection"
        },
        {
          "include": "#assignment"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "block-1": {
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l1.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l1.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-2"
        }
      ]
    },
    "block-2": {
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l2.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l2.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-3"
        }
      ]
    },
    "block-3": {
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l3.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l3.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-4"
        }
      ]
    },
    "block-4": {
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l4.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l4.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-5"
        }
      ]
    },
    "block-5": {
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l5.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l5.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-6"
        }
      ]
    },
    "block-6": {
      "comment": "最深层，自递归：深度超过 6 的 begin/end 保持本层颜色，不会漏匹配。",
      "begin": "\\bbegin\\b",
      "end": "\\bend\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.block.l6.verilog"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.other.block.l6.verilog"
        }
      },
      "patterns": [
        {
          "include": "#statement"
        },
        {
          "include": "#block-6"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.verilog",
          "match": "//.*$"
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.verilog",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.verilog",
          "match": "\\\\."
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "name": "keyword.control.preprocessor.verilog",
          "match": "`(?:define|undef|ifdef|ifndef|elsif|else|endif|include|timescale|default_nettype|resetall|celldefine|endcelldefine|line|begin_keywords|end_keywords|unconnected_drive|nounconnected_drive)\\b"
        },
        {
          "name": "variable.other.macro.verilog",
          "match": "`[A-Za-z_][A-Za-z0-9_$]*"
        }
      ]
    },
    "module": {
      "patterns": [
        {
          "match": "\\b(module|macromodule|primitive)\\s+([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.other.module.verilog"
            },
            "2": {
              "name": "entity.name.type.module.verilog"
            }
          }
        },
        {
          "name": "keyword.other.module.verilog",
          "match": "\\b(?:endmodule|endprimitive)\\b"
        }
      ]
    },
    "task-function": {
      "patterns": [
        {
          "match": "\\b(task|function)\\s+(?:automatic\\s+|static\\s+)?(?:\\[[^\\]]*\\]\\s*)?([A-Za-z_][A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.control.task.verilog"
            },
            "2": {
              "name": "entity.name.function.verilog"
            }
          }
        },
        {
          "name": "keyword.control.task.verilog",
          "match": "\\b(?:endtask|endfunction)\\b"
        }
      ]
    },
    "edge": {
      "name": "keyword.other.edge.verilog",
      "match": "\\b(?:posedge|negedge|edge|or)\\b"
    },
    "control": {
      "name": "keyword.control.verilog",
      "match": "\\b(?:always|always_comb|always_ff|always_latch|initial|if|else|case|casex|casez|endcase|default|for|while|repeat|forever|fork|join|join_any|join_none|generate|endgenerate|assign|deassign|force|release|wait|disable|return|break|continue)\\b"
    },
    "port-direction": {
      "comment": "端口方向单独成类：input/output/inout 用青色（参考 TerosHDL）",
      "name": "storage.type.port.verilog",
      "match": "\\b(?:input|output|inout)\\b"
    },
    "storage": {
      "name": "storage.type.verilog",
      "match": "\\b(?:reg|wire|logic|bit|byte|int|integer|real|realtime|time|shortint|longint|tri|tri0|tri1|wand|wor|trior|supply0|supply1)\\b"
    },
    "modifier": {
      "name": "storage.modifier.verilog",
      "match": "\\b(?:parameter|localparam|defparam|genvar|signed|unsigned|automatic|static)\\b"
    },
    "number": {
      "patterns": [
        {
          "comment": "带位宽的进制数：8'hFF、4'b10xz、1'bx、16'sd123",
          "name": "constant.numeric.verilog",
          "match": "\\b\\d[\\d_]*'[sS]?[bBoOdDhH][0-9a-fA-FxXzZ?_]+"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][-+]?\\d+)?"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "system-task": {
      "name": "support.function.system.verilog",
      "match": "\\$[A-Za-z_][A-Za-z0-9_$]*"
    },
    "assignment": {
      "comment": "赋值符号 <= 与 = 不参与运算符着色（用户要求默认黑色）。必须放在 #operator 之前；= 用 (?![=]) 负向前瞻，避免吞掉 == 与 ===。给了 scope 名是为了可在测试中断言，但没有任何主题/自定义规则给它颜色，所以渲染为默认黑色。",
      "name": "assignment.operator.verilog",
      "match": "<=|=(?![=])"
    },
    "operator": {
      "name": "keyword.operator.verilog",
      "match": ">=|===|!==|==|!=|&&|\\|\\||<<<|>>>|<<|>>|\\*\\*|[+\\-*/%<>!~&|^?:]"
    },
    "punctuation": {
      "name": "punctuation.verilog",
      "match": "[;,.()\\[\\]{}#@]"
    },
    "instance-param": {
      "comment": "例化模块名（后跟参数表 #(...)）。TextMate 的 match 不能跨行，所以例化只能按行局部识别：这是参数表写在模块名同一行的情形",
      "match": "\\b([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*#\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.type.instance.verilog"
        }
      }
    },
    "instance-inline": {
      "comment": "例化：模块名 实例名 (（同一行）。互斥地，module 声明已被更早的 #module 规则消费",
      "match": "\\b([A-Za-z_][A-Za-z0-9_$]*)\\s+([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.type.instance.verilog"
        },
        "2": {
          "name": "entity.name.instance.verilog"
        }
      }
    },
    "instance-name": {
      "comment": "例化名（参数表跨行时，实例名出现在 ')' 之后）。关键字黑名单防止 (posedge clk) begin 的 begin 被误着色",
      "match": "(?<=\\))\\s+(?!(?:begin|end|if|else|case|endcase|default|always|initial|for|while|forever|assign|module|input|output|inout|wire|reg|parameter|localparam|generate)\\b)([A-Za-z_][A-Za-z0-9_$]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.instance.verilog"
        }
      }
    },
    "port-connection": {
      "comment": ".端口名( —— 只有着个名字；分层变色不受影响",
      "match": "\\.\\s*([A-Za-z_][A-Za-z0-9_$]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "variable.other.port.verilog"
        }
      }
    }
  }
}
