{
  "module": {
    "prefix": "module",
    "body": [
      "module ${1:name} #(",
      "    parameter ${2:WIDTH} = ${3:8}",
      ") (",
      "    input                  ${4:clk},",
      "    input                  ${5:rst_n},",
      "    output reg [${2:WIDTH}-1:0] ${6:q}",
      ");",
      "",
      "    $0",
      "",
      "endmodule"
    ],
    "description": "带 parameter 与 ANSI 端口的模块骨架"
  },
  "always_clk": {
    "prefix": "always",
    "body": [
      "always @(posedge ${1:clk} or negedge ${2:rst_n}) begin",
      "    if (!${2:rst_n}) begin",
      "",
      "    end",
      "    else begin",
      "        $0",
      "    end",
      "end"
    ],
    "description": "带异步复位的时序逻辑块"
  },
  "always_comb": {
    "prefix": "alwaysc",
    "body": [
      "always @(*) begin",
      "    $0",
      "end"
    ],
    "description": "组合逻辑块"
  },
  "case": {
    "prefix": "case",
    "body": [
      "case (${1:sel})",
      "    ${2:1'b0}: begin",
      "        $0",
      "    end",
      "    default: begin",
      "    end",
      "endcase"
    ],
    "description": "case 语句"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) begin",
      "",
      "    end",
      "    else begin",
      "        $0",
      "    end",
      "end"
    ],
    "description": "if / else 块"
  },
  "forloop": {
    "prefix": "for",
    "body": [
      "for (${1:i} = 0; ${1:i} < ${2:N}; ${1:i} = ${1:i} + 1) begin",
      "    $0",
      "end"
    ],
    "description": "for 循环"
  },
  "assign": {
    "prefix": "assign",
    "body": [
      "assign ${1:out} = ${2:expr};"
    ],
    "description": "连续赋值"
  },
  "parameter": {
    "prefix": "parameter",
    "body": [
      "parameter ${1:WIDTH} = ${2:8};"
    ],
    "description": "参数声明"
  },
  "localparam": {
    "prefix": "localparam",
    "body": [
      "localparam ${1:NAME} = ${2:value};"
    ],
    "description": "局部参数"
  },
  "define": {
    "prefix": "define",
    "body": [
      "`define ${1:NAME} ${2:value}"
    ],
    "description": "宏定义"
  },
  "ifdef": {
    "prefix": "ifdef",
    "body": [
      "`ifdef ${1:SYNTHESIS}",
      "    $0",
      "`else",
      "",
      "`endif"
    ],
    "description": "条件编译"
  },
  "timescale": {
    "prefix": "timescale",
    "body": [
      "`timescale 1ns / 1ps"
    ],
    "description": "时间单位与精度"
  },
  "instance": {
    "prefix": "inst",
    "body": [
      "${1:mod} #(",
      "    .${2:PARAM} (${3:value})",
      ") ${4:u_${1:mod}} (",
      "    .${5:port} (${6:signal})",
      ");"
    ],
    "description": "带参数的名义端口例化"
  },
  "fsm": {
    "prefix": "fsm",
    "body": [
      "localparam ${1:S_IDLE} = ${2:2'd0};",
      "localparam ${3:S_RUN}  = ${4:2'd1};",
      "",
      "reg [1:0] state, next_state;",
      "",
      "// 状态寄存器",
      "always @(posedge ${5:clk} or negedge ${6:rst_n}) begin",
      "    if (!${6:rst_n}) state <= ${1:S_IDLE};",
      "    else             state <= next_state;",
      "end",
      "",
      "// 次态逻辑",
      "always @(*) begin",
      "    next_state = state;",
      "    case (state)",
      "        ${1:S_IDLE}: $0",
      "        default : next_state = ${1:S_IDLE};",
      "    endcase",
      "end"
    ],
    "description": "两段式状态机骨架"
  },
  "testbench": {
    "prefix": "tb",
    "body": [
      "`timescale 1ns / 1ps",
      "",
      "module ${1:tb};",
      "",
      "    reg  ${2:clk} = 1'b0;",
      "    reg  ${3:rst_n} = 1'b0;",
      "    wire ${4:dut_out};",
      "",
      "    always #5 ${2:clk} = ~${2:clk};",
      "",
      "    ${5:dut} u_dut (",
      "        .clk   (${2:clk}),",
      "        .rst_n (${3:rst_n}),",
      "        .out   (${4:dut_out})",
      "    );",
      "",
      "    initial begin",
      "        #100 ${3:rst_n} = 1'b1;",
      "        #1000 \\$finish;",
      "    end",
      "",
      "endmodule"
    ],
    "description": "测试平台骨架（含时钟与复位）"
  }
}
